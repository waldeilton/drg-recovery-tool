# DRG Recovery Tool — Production Environment Configuration
# IMPORTANT: Never commit actual secrets. Use encrypted environment variables.

# === APPLICATION ===
NODE_ENV=production
APP_NAME=DRG Recovery Tool
APP_VERSION=1.0.0
LOG_LEVEL=info

# === SERVER ===
PORT=443
HOST=0.0.0.0
API_URL=https://digitalrecovery.com/tools/DRGRecoveryTool

# === DATABASE ===
# DB_HOST=prod-db.digitalrecovery.com
# DB_PORT=5432
# DB_NAME=drg_recovery_prod
# DB_USER=[ENCRYPTED]
# DB_PASSWORD=[ENCRYPTED]

# === DIGITAL RECOVERY LABS INTEGRATION ===
# LABS_API_URL=https://api.digitalrecovery.com/v1
# LABS_API_KEY=[ENCRYPTED]
# LABS_INTAKE_ENDPOINT=/api/escalations/intake

# === FILE STORAGE ===
# STORAGE_PATH=/var/data/drg-recovery
# MAX_UPLOAD_SIZE=256MB
# S3_BUCKET=drg-recovery-prod (if using S3)
# S3_REGION=eu-west-1

# === TELEMETRY ===
TELEMETRY_ENABLED=true
ANALYTICS_ENABLED=true
CRASH_REPORTING=true

# === LICENSING ===
LICENSE_MODE=production
# LICENSE_KEY=[ENCRYPTED]
# LICENSE_API_URL=https://licensing.digitalrecovery.com/v1

# === SECURITY ===
# HTTPS_ENABLED=true
# HTTPS_CERT_PATH=/etc/ssl/certs/drg-recovery.crt
# HTTPS_KEY_PATH=/etc/ssl/private/drg-recovery.key

# === EXTERNAL SERVICES ===
# SLACK_WEBHOOK_URL=[ENCRYPTED]
# SENTRY_DSN=[ENCRYPTED]
# SENDGRID_API_KEY=[ENCRYPTED]

# === PAYMENT PROCESSING ===
# STRIPE_API_KEY=[ENCRYPTED]
# STRIPE_WEBHOOK_SECRET=[ENCRYPTED]

# === MONITORING & LOGGING ===
# LOG_AGGREGATION_URL=https://logs.digitalrecovery.com
# METRICS_EXPORT_URL=https://metrics.digitalrecovery.com
# HEALTH_CHECK_ENABLED=true

# === DEBUGGING ===
DEBUG=false
VERBOSE_LOGS=false
SHOW_TIMESTAMPS=true

# === FEATURE FLAGS ===
ENABLE_RAID_DETECTION=false
ENABLE_ENCRYPTION_DETECTION=false
ENABLE_FORENSIC_EXPORT=false
ENABLE_ENTERPRISE_TIER=false

# === PERFORMANCE ===
CACHE_ENABLED=true
CACHE_TTL=3600
MAX_CONCURRENT_SCANS=10
