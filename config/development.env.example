# DRG Recovery Tool — Development Environment Configuration
# Copy this file to .env.development and fill in your local values

# === APPLICATION ===
NODE_ENV=development
APP_NAME=DRG Recovery Tool
APP_VERSION=1.0.0-dev
LOG_LEVEL=debug

# === SERVER ===
PORT=3000
HOST=localhost
API_URL=http://localhost:3000

# === DATABASE (if needed) ===
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=drg_recovery_dev
# DB_USER=postgres
# DB_PASSWORD=dev_password

# === DIGITAL RECOVERY LABS INTEGRATION ===
# LABS_API_URL=http://localhost:3001/api
# LABS_API_KEY=dev_key_12345
# LABS_INTAKE_ENDPOINT=/api/escalations

# === FILE STORAGE ===
# STORAGE_PATH=/tmp/drg-recovery-dev
# MAX_UPLOAD_SIZE=256MB

# === TELEMETRY (Disabled in Dev) ===
TELEMETRY_ENABLED=false
ANALYTICS_DISABLED=true

# === LICENSING (Dev/Unlicensed) ===
LICENSE_MODE=development
# LICENSE_KEY=dev_key

# === TESTING ===
TEST_DATABASE_URL=sqlite:///./test.db
TEST_TIMEOUT=10000

# === EXTERNAL SERVICES ===
# SLACK_WEBHOOK_URL=https://hooks.slack.com/... (optional)
# SENTRY_DSN=https://... (optional, error tracking)

# === DEBUGGING ===
DEBUG=true
VERBOSE_LOGS=true
SHOW_TIMESTAMPS=true

# === EXPERIMENTAL FEATURES ===
# Feature flags for testing new functionality
ENABLE_RAID_DETECTION=false
ENABLE_ENCRYPTION_DETECTION=false
ENABLE_FORENSIC_EXPORT=false
