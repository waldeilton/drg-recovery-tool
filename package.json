{
  "name": "drg-recovery-tool",
  "version": "1.0.0",
  "description": "Professional-grade data recovery. Consumer-simple price.",
  "private": true,
  "main": "dist/index.js",
  "homepage": "https://digitalrecovery.com/tools/DRGRecoveryTool",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalrecoverygroup/DRGRecoveryTool.git"
  },
  "bugs": {
    "url": "https://github.com/digitalrecoverygroup/DRGRecoveryTool/issues"
  },
  "keywords": [
    "data-recovery",
    "file-recovery",
    "windows",
    "macos",
    "linux",
    "drg",
    "digital-recovery"
  ],
  "author": "Digital Recovery Group",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "webpack serve --mode development",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --fix --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "pre-commit": "npm run lint && npm run test:unit && npm run type-check",
    "package:windows": "electron-builder --win",
    "package:macos": "electron-builder --mac",
    "package:linux": "electron-builder --linux AppImage",
    "dist": "npm run build:prod && npm run package:windows && npm run package:macos && npm run package:linux",
    "ci": "npm run lint && npm run test:coverage",
    "bump:version": "npm version"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "optionalDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
